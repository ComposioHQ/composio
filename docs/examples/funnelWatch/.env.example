
# --- Agent (OpenAI Responses API) ---
OPENAI_API_KEY=
GROWTH_PULSE_MODEL=gpt-5.2

# --- Composio (triggers + Slack send) ---
COMPOSIO_API_KEY=
# Composio user_id that scopes the session, connected accounts, and tools.
GROWTH_PULSE_USER_ID=
# Composio Slack action slug used to deliver internal updates.
SLACK_SEND_SLUG=SLACKBOT_SEND_MESSAGE
COMPOSIO_WEBHOOK_SECRET=
# Accept unsigned webhooks even when the secret is set — ONLY for local tools
# (tools/simulate.py posts unsigned). Leave unset in production.
GROWTH_PULSE_ALLOW_UNSIGNED=
# Optional JSON toolkit version pins, e.g. {"slackbot": "20260601_00"}. Pinning keeps
# payload/tool schemas stable and lets manual execution drop the version-check skip.
COMPOSIO_TOOLKIT_VERSIONS=
# --- Slack ---
# Internal channel for default monitor alerts.
SLACK_CHANNEL=#funnel-watch
SLACK_BOT_USER_ID=