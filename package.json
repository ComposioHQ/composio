{
  "name": "composio",
  "version": "0.10.0-alpha.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "description": "",
  "workspaces": [
    "ts/packages/core",
    "ts/packages/experimental",
    "ts/packages/slim",
    "ts/packages/json-schema-to-effect-schema",
    "ts/packages/json-schema-to-zod",
    "ts/packages/cli",
    "ts/packages/cli-keyring",
    "ts/packages/ts-builders",
    "ts/packages/providers/*",
    "python"
  ],
  "scripts": {
    "build": "turbo build",
    "build:binary": "turbo build:binary --filter=./ts/packages/cli",
    "build:binary:all": "turbo build:binary:all --filter=./ts/packages/cli",
    "build:binary:checksums": "turbo build:binary:checksums --filter=./ts/packages/cli",
    "install:binary": "turbo install:binary --filter=./ts/packages/cli",
    "build:packages": "turbo build --filter=./ts/packages/**",
    "cli:record": "turbo run record --filter=./ts/packages/cli",
    "record": "turbo run record",
    "test": "pnpm run test:toolchain && pnpm run test:install-sh && pnpm run test:release-workflow && pnpm run test:issue-triage && pnpm run test:provider-compatibility && pnpm run test:context7 && turbo test --filter=./ts/packages/** --filter=!@e2e-tests/* && pnpm run test:examples",
    "test:install-sh": "bash test/install-sh-release-resolution.test.sh && bash test/install-sh-atomic-replace.test.sh",
    "test:release-workflow": "bun run test/release-workflow.test.ts",
    "test:issue-triage": "bun test test/issue-triage.test.ts",
    "test:provider-compatibility": "bun test test/provider-compatibility.test.ts",
    "test:toolchain": "bun run test/mise-bun-pin.test.ts",
    "test:context7": "node --test test/context7-check.test.mjs",
    "agent:task": "bun scripts/agent-task.ts",
    "test:agent-workflow": "bun test --timeout 30000 test/agent-task.test.ts",
    "check:context7": "node scripts/context7-check.mjs",
    "test:examples": "tsx ts/scripts/validate-examples.ts",
    "test:e2e": "turbo test:e2e --filter='@e2e-tests/*'",
    "test:e2e:node": "turbo test:e2e:node --filter='@e2e-tests/node-*'",
    "test:e2e:cli": "turbo test:e2e:cli --filter='@e2e-tests/cli-*'",
    "test:e2e:install": "turbo test:e2e:install --filter='@e2e-tests/cli-install'",
    "test:e2e:cloudflare": "turbo test:e2e:cloudflare --filter='@e2e-tests/cf-*'",
    "test:ui": "vitest --ui",
    "typecheck": "turbo typecheck --filter=./ts/packages/**",
    "typecheck:examples": "turbo typecheck --filter='./ts/examples/*'",
    "lint:examples": "turbo lint --filter='./ts/examples/*'",
    "lint": "effect-tsgo oxlint --type-aware -c .oxlintrc.json ts test tools/oxlint tsdown.config.base.ts && pnpm run lint:antislop",
    "lint:antislop": "node scripts/check-antislop.mjs && pnpm run lint:effect-rules",
    "lint:effect-rules": "oxlint ts/packages/cli/src",
    "lint:antislop:scan": "ast-grep scan --config sgconfig.yml --error=no-suppress-all --error=unused-suppression",
    "lint:antislop:prune": "node scripts/check-antislop.mjs --prune",
    "test:antislop": "ast-grep test --config sgconfig.yml --skip-snapshot-tests && node --test test/antislop.test.mjs && pnpm run test:effect-rules",
    "test:effect-rules": "tsx tools/oxlint/effect/rules/require-cause-when-narrowing.test.ts && tsx tools/oxlint/effect/rules/no-ordie-in-service-construction.test.ts && bun test test/effect-lint.test.ts",
    "typecheck:effect-rules": "tsc -p tsconfig.effect-rules.json",
    "lint:packages": "effect-tsgo oxlint --type-aware -c .oxlintrc.json ts/packages",
    "lint:fix": "oxlint --fix .",
    "lint:fix:packages": "oxlint --fix ts/packages",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "create:provider": "bash ts/scripts/create-provider.sh",
    "create:example": "bash ts/scripts/create-example.sh",
    "check:peer-deps": "tsx ts/scripts/check-peer-deps.ts",
    "check:provider-compatibility": "tsx ts/scripts/check-provider-compatibility.ts",
    "update:peer-deps": "tsx ts/scripts/update-peer-deps.ts",
    "validate:agent-skills": "bun ts/scripts/validate-agent-skills.ts",
    "validate:changesets": "node ts/scripts/validate-changesets.mjs",
    "validate:skill-routing": "bun ts/scripts/test-skill-routing.ts",
    "validate:cli-skills": "bun test test/cli-skills.test.ts && bun ts/scripts/check-cli-skills.ts",
    "prepublish": "pnpm run build:packages",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:release": "bash ts/scripts/changeset-release.sh",
    "changeset:pre-enter": "changeset pre enter",
    "changeset:pre-exit": "changeset pre exit",
    "clean": "git clean -xdf .turbo node_modules ts/packages/**/.turbo ts/packages/**/node_modules ts/packages/**/dist",
    "clean:workspace": "pnpm turbo clean",
    "typecheck:agent-workflow": "bun node_modules/typescript/bin/tsc -p tsconfig.agent-workflow.json",
    "test:sdk-release": "bun test test/sdk-release-*.test.ts",
    "typecheck:sdk-release": "bun node_modules/typescript/bin/tsc -p tsconfig.sdk-release.json",
    "check:docs-reference": "bun scripts/docs-reference-check/main.ts",
    "test:docs-reference-check": "bun test test/docs-reference-check.test.ts",
    "typecheck:docs-reference-check": "bun node_modules/typescript/bin/tsc -p tsconfig.docs-reference-check.json"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.3 <25",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@ast-grep/cli": "0.51.3",
    "@changesets/apply-release-plan": "8.1.1",
    "@changesets/assemble-release-plan": "7.0.0",
    "@changesets/cli": "^3.0.3",
    "@changesets/config": "4.0.1",
    "@changesets/read": "^1.0.1",
    "@changesets/types": "7.0.0",
    "@composio/anthropic": "workspace:*",
    "@composio/core": "workspace:*",
    "@composio/openai": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/tsgo": "0.70.0",
    "@manypkg/get-packages": "3.1.0",
    "@mdx-js/mdx": "^3.1.1",
    "@oxlint/plugins": "1.94.0",
    "@types/bun": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitest/ui": "catalog:",
    "effect": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "1.94.0",
    "oxlint-plugin-eslint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "^3.10.1",
    "publint": "catalog:",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.6",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "^2.11.11",
    "typescript": "catalog:",
    "typescript6": "catalog:ts6",
    "unist-util-visit": "^5.1.0",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "{test,ts}/**/*.{ts,tsx,mts,cts}": [
      "oxlint --fix"
    ],
    "tsdown.config.base.ts": [
      "oxlint --fix"
    ],
    "ts/packages/**/*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ],
    "python/**/*.py": [
      "ruff check --fix --config python/config/ruff.toml",
      "ruff format --config python/config/ruff.toml"
    ]
  }
}
