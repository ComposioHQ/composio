      {
        "id": "anthropic-tool-result-correlation",
        "summary": "Preserve the originating `tool_use_id` in Python Anthropic tool results and retain session execution status, log IDs, and returned Instant charges in provider execution results. Clarify the TypeScript Anthropic helpers' existing result projection and message correlation in their API documentation.",
        "releases": [
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          },
          {
            "name": "@composio/anthropic",
            "type": "patch"
          }
        ]
      },
      {
        "id": "blocked-session-result-type",
        "summary": "Include `blocked` in the Python session execution result type so blocked results can be parsed by `ToolRouterSessionExecuteResponse`.",
        "releases": [
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "claude-agent-sdk-wheel-tests",
        "summary": "Exclude the Claude Agent SDK provider's tests package from its wheel to avoid shadowing consuming projects' tests.",
        "releases": [
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "composio-client-update",
        "summary": "Update the API client dependencies to 2.1.32 to include the latest API changes.",
        "releases": [
          {
            "name": "@composio/core",
            "type": "patch"
          },
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "custom-tool-coroutine-check",
        "summary": "Stop emitting a `DeprecationWarning` on Python 3.14+ when registering custom tools. The async-function check now uses `inspect.iscoroutinefunction`, and async tools are still rejected as before.",
        "releases": [
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "custom-toolkits-top-level",
        "summary": "Custom toolkits are no longer experimental. Use `composio.customToolkits` in TypeScript and `composio.custom_toolkits` in Python. `composio.experimental.customToolkits` and `composio.experimental.custom_toolkits` are deprecated aliases of the same object and keep working. Python also exports the class as `CustomToolkits`; `ExperimentalCustomToolkits` stays as an alias.",
        "releases": [
          {
            "name": "@composio/core",
            "type": "minor"
          },
          {
            "name": "@composio/slim",
            "type": "minor"
          },
          {
            "name": "@composio/python-sdk",
            "type": "minor"
          }
        ]
      },
      {
        "id": "google-parameters-json-schema",
        "summary": "Fix Gemini rejecting Composio tools with a 400 such as `Unknown name \"examples\"`. `wrapTool` and `wrapTools` now put each tool's schema in `parametersJsonSchema` instead of `parameters`, so JSON Schema keywords that Composio tools carry, such as `examples`, `const`, `null` types, and integer enums, reach Gemini intact. The `@google/genai` peer dependency now requires `^1.6.0`, the first release that supports `parametersJsonSchema` on function declarations.",
        "releases": [
          {
            "name": "@composio/google",
            "type": "minor"
          }
        ]
      },
      {
        "id": "google-python-vertex-schema",
        "summary": "Fix `composio_google` raising `ParseError` while wrapping tools whose schemas use JSON Schema keywords outside the Vertex AI `Schema` subset, such as `human_parameter_name`, `examples`, `const`, `oneOf`, type lists, and non-string enums. `wrap_tool` now reduces each schema to that subset: it drops unsupported keywords, turns `oneOf` into `anyOf`, a `null` type or enum member into `nullable`, a string `const` into a one-value `enum`, and moves non-string enum values into the description.",
        "releases": [
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "openai-agents-dependency-compatibility",
        "summary": "Allow OpenAI Agents SDK 0.21 in the TypeScript provider's peer dependencies. Require composio 0.32.0 or newer for the Python OpenAI Agents provider so installs cannot retain an older core.",
        "releases": [
          {
            "name": "@composio/openai-agents",
            "type": "patch"
          },
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "python-trigger-toolkit-filter-underscore",
        "summary": "Match the `toolkit` filter of trigger subscriptions for toolkits whose slug contains an underscore\n\nThe toolkit of an incoming event is derived from the first `_` segment of its trigger slug, so `ONE_DRIVE_FILE_CREATED_TRIGGER` was attributed to `ONE` and `handle(toolkit=\"one_drive\")` skipped every OneDrive event. The same happened to `launch_darkly` and `agent_mail`. A `toolkit` filter now also matches when the trigger slug starts with `<toolkit>_`.",
        "releases": [
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "session-execution-types",
        "summary": "Use generated client types for inline local-tool payloads and share Python result handling between session tool and meta-tool execution. Public methods and request and response shapes are unchanged.",
        "releases": [
          {
            "name": "@composio/core",
            "type": "patch"
          },
          {
            "name": "@composio/slim",
            "type": "patch"
          },
          {
            "name": "@composio/python-sdk",
            "type": "patch"
          }
        ]
      },
      {
        "id": "tidy-dependency-consolidation",
        "summary": "Update runtime dependencies, require patched Zod 4 releases where used directly, support Anthropic SDK 1.6, and update the AutoGen provider's FLAML dependency. Preserve Zod 3 compatibility fixtures and existing framework version boundaries.",
        "releases": [
          {
            "name": "@composio/core",
            "type": "patch"
          },
          {
            "name": "@composio/slim",
            "type": "patch"
          },
