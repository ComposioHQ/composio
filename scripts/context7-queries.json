        ["GET /tools/{tool_slug}"],
        ["POST /tools/execute/{tool_slug}/input"],
        ["POST /tools/scopes/required"],
        ["toolkit_versions"]
      ]
    },
    {
      "id": "rest-explicit-pinned-version",
      "query": "How do I preserve the old Composio REST v3 pinned toolkit version when calling v3.1, and does the previous v3 API remain supported?",
