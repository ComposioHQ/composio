    {
      "id": "python-install-current-sdk",
      "query": "How do I install the current Composio Python SDK for OpenAI Agents, and which Python version is required?",
      "source": "https://docs.composio.dev/docs/quickstart.md",
      "expect": [
        ["pip install", "uv add"],
        ["composio"],
        ["composio-openai-agents"],
        ["openai-agents"],
        ["Python 3.10"]
      ]
    },
    {
      "id": "typescript-install-current-sdk",
      "query": "How do I install Composio for the OpenAI Agents SDK in TypeScript, and what Node.js version and module format does it require?",
      "source": "https://docs.composio.dev/docs/quickstart.md",
      "expect": [
        [
          "npm install @composio/core @composio/openai-agents @openai/agents",
          "pnpm add @composio/core @composio/openai-agents @openai/agents",
          "bun add @composio/core @composio/openai-agents @openai/agents",
          "yarn add @composio/core @composio/openai-agents @openai/agents"
        ],
        ["Node.js 22.22.3"],
        ["ESM-only"]
      ]
    },
