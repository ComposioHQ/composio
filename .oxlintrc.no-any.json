{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Repository-wide type-safety invariant. Keep this config deliberately
  // narrow so every authored TypeScript file, including tests and docs, can be
  // checked without inheriting package-specific lint policies.
  "plugins": ["typescript"],
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    "**/.venv/**",
    "**/.next/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/site-packages/**",
    "**/*.d.ts",
    "docs/agent/lib/docs-index.ts",
    "ts/vendor/**",
    "ts/packages/cli-local-tools/vendor/**",
    "ts/packages/core/generated/**",
    "ts/packages/core/pack/generated/**",
    "ts/packages/**/.generated/**",
    "ts/packages/**/acp-adapters/**",
    "ts/examples/**/dist-worker/**"
  ],
  "rules": {
    "typescript/no-explicit-any": [
      "error",
      {
        "fixToUnknown": true
      }
    ]
  }
}
