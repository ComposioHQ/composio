              },
              "text": {
                "maxLength": 400,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "text",
              "source_ids",
              "migration",
              "migration_source_ids",
            ],
            "type": "object",
          },
          "breakingSection": {
            "additionalProperties": false,
            "properties": {
              "claims": {
                "items": {
                  "$ref": "#/$defs/breakingClaim",
                },
                "maxItems": 12,
                "minItems": 1,
                "type": "array",
              },
              "kind": {
                "const": "breaking_changes",
              },
            },
            "required": [
              "kind",
              "claims",
            ],
            "type": "object",
          },
          "claim": {
            "additionalProperties": false,
            "properties": {
              "source_ids": {
                "$ref": "#/$defs/sourceIds",
              },
              "text": {
                "maxLength": 400,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "text",
              "source_ids",
            ],
            "type": "object",
          },
          "ordinarySection": {
            "additionalProperties": false,
            "properties": {
              "claims": {
                "items": {
                  "$ref": "#/$defs/claim",
                },
                "maxItems": 12,
                "minItems": 1,
                "type": "array",
              },
              "kind": {
                "enum": [
                  "whats_new",
                  "improvements",
                  "bug_fixes",
                ],
              },
            },
            "required": [
              "kind",
              "claims",
            ],
            "type": "object",
          },
          "sourceIds": {
            "items": {
              "maxLength": 80,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 8,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true,
          },
        },
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "sdk-release-changelog/v1",
          },
          "sections": {
            "items": {
