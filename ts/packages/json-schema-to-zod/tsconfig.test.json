{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.options.json",
  "compilerOptions": {
    // widened so the shared corpus loader, owned by `@composio/core`, is in range
    "rootDir": "../.."
  },
  "include": ["src/**/*", "test/**/*", "package.json"],
  "exclude": ["node_modules", "../../../node_modules", "**/dist", "test/e2e", "test-sandboxes"]
}
