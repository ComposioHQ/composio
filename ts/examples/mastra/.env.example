# Composio API key — https://app.composio.dev
COMPOSIO_API_KEY=your_composio_api_key

# LLM key — the examples default to OpenAI (gpt-5-mini). To use Anthropic instead,
# swap the model import in the source (see README) and set ANTHROPIC_API_KEY.
OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional: target the staging backend instead of production.
# COMPOSIO_BASE_URL=https://staging-backend.composio.dev
