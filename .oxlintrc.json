              },
              { "name": "path", "message": "Use Path from @effect/platform instead." },
              { "name": "node:path", "message": "Use Path from @effect/platform instead." }
            ],
            "patterns": [
              {
                "group": ["fs/*", "node:fs/*"],
                "message": "Use FileSystem from @effect/platform instead."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["ts/packages/cli/src/services/tool-input-validation.ts"],
      "rules": {
        "no-restricted-imports": [
